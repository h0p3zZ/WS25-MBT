		<transition id="id29">
			<source ref="id22"/>
			<target ref="id21"/>
			<label kind="synchronisation" x="-297" y="-119">unlock?</label>
			<nail x="-238" y="-110"/>
		</transition>
		<transition id="id30">
			<source ref="id21"/>
			<target ref="id22"/>
