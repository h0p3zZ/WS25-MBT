		<transition id="id35">
			<source ref="id19"/>
			<target ref="id20"/>
			<label kind="synchronisation" x="-382" y="-118">lock?</label>
			<nail x="-391" y="-110"/>
		</transition>
		<transition id="id36">
			<source ref="id20"/>
			<target ref="id19"/>
			<label kind="synchronisation" x="-476" y="-118">unlock?</label>
			<nail x="-408" y="-110"/>
		</transition>
	</template>
	<system>// Place template instantiations here.
car = Car();
alarm = Alarm();
user = User();
// List one or more processes to be composed into a system.
system car, alarm, user;</system>
	<queries>
		<query>
			<formula>E&lt;&gt; car.OpenAndLocked</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; car.OpenAndUnlocked</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; car.ClosedAndUnlocked</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>A[] not deadlock</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; car.ClosedAndLocked</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; alarm.Armed</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; alarm.FlashAndSound</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; alarm.Flash</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; alarm.SilentAndOpen</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; (alarm.FlashAndSound and alarm.t == 30)</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; (alarm.Flash and alarm.t == 300)</formula>
			<comment>Alarm may flash for the full 300 seconds</comment>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:11:07 +0100">
			</result>
		</query>
		<query>
			<formula>alarm.FlashAndSound --&gt; car.OpenAndUnlocked</formula>
			<comment/>
			<result outcome="failure" type="quality" timestamp="2026-01-05 21:18:36 +0100">
			</result>
		</query>
		<query>
			<formula>A[] alarm.FlashAndSound imply !car.ClosedAndUnlocked</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-01-05 21:12:25 +0100">
			</result>
		</query>
	</queries>
</nta>
