		<transition id="id31">
			<source ref="id21"/>
			<target ref="id19"/>
			<label kind="synchronisation" x="-331" y="-144">open?</label>
			<nail x="-306" y="-144"/>
		</transition>
		<transition id="id32">
			<source ref="id19"/>
			<target ref="id21"/>
			<label kind="synchronisation" x="-331" y="-178">close?</label>
			<nail x="-306" y="-161"/>
		</transition>
		<transition id="id33">
			<source ref="id22"/>
			<target ref="id20"/>
			<label kind="synchronisation" x="-331" y="-84">open?</label>
