<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
// Simple channels for the car
broadcast chan open, close, lock, unlock;

// Communication channel for the alarm
chan arm;</declaration>
	<template>
		<name>Alarm</name>
		<declaration>clock t;</declaration>
		<location id="id0" x="-212" y="-17">
			<name x="-229" y="-51">Armed</name>
		</location>
		<location id="id1" x="-331" y="-17">
			<name x="-365" y="-8">Idle</name>
		</location>
		<location id="id2" x="-59" y="-17">
			<name x="-110" y="-8">FlashAndSound</name>
			<label kind="invariant" x="-85" y="8">t &lt;= 30</label>
		</location>
		<location id="id3" x="76" y="-17">
			<name x="51" y="-8">Flash</name>
			<label kind="invariant" x="34" y="8">t &lt;= 300</label>
		</location>
		<location id="id4" x="212" y="-17">
			<name x="221" y="-42">SilentAndOpen</name>
		</location>
		<init ref="id1"/>
		<transition id="id5">
			<source ref="id4"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="144" y="-119">unlock?</label>
			<nail x="212" y="-102"/>
			<nail x="-280" y="-102"/>
		</transition>
		<transition id="id6">
			<source ref="id3"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="8" y="-102">unlock?</label>
			<nail x="76" y="-85"/>
			<nail x="-280" y="-85"/>
		</transition>
		<transition id="id7">
			<source ref="id2"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="-127" y="-85">unlock?</label>
			<nail x="-59" y="-68"/>
			<nail x="-280" y="-68"/>
		</transition>
		<transition id="id8">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="-297" y="-42">unlock?</label>
			<nail x="-272" y="-25"/>
		</transition>
		<transition id="id9">
			<source ref="id4"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="17" y="42">close?</label>
			<nail x="178" y="34"/>
			<nail x="-170" y="34"/>
		</transition>
		<transition id="id10">
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="guard" x="110" y="-34">t == 300</label>
		</transition>
		<transition id="id11">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="-289" y="-8">arm?</label>
			<nail x="-272" y="-8"/>
		</transition>
		<transition id="id12">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="-17" y="-42">t == 30</label>
		</transition>
		<transition id="id13">
			<source ref="id0"/>
			<target ref="id2"/>
			<label kind="synchronisation" x="-153" y="-34">open?</label>
			<label kind="assignment" x="-153" y="-42">t = 0</label>
		</transition>
	</template>
	<template>
		<name>User</name>
		<location id="id14" x="-93" y="-25">
			<name x="-85" y="-17">Idle</name>
		</location>
		<init ref="id14"/>
		<transition id="id15">
			<source ref="id14"/>
			<target ref="id14"/>
			<label kind="synchronisation" x="-178" y="-25">close!</label>
			<nail x="-144" y="-17"/>
			<nail x="-144" y="-34"/>
		</transition>
		<transition id="id16">
			<source ref="id14"/>
			<target ref="id14"/>
			<label kind="synchronisation" x="-110" y="25">open!</label>
			<nail x="-85" y="25"/>
			<nail x="-102" y="25"/>
		</transition>
		<transition id="id17">
			<source ref="id14"/>
			<target ref="id14"/>
			<label kind="synchronisation" x="-42" y="-42">lock!</label>
			<nail x="-42" y="-34"/>
			<nail x="-42" y="-17"/>
		</transition>
		<transition id="id18">
			<source ref="id14"/>
			<target ref="id14"/>
			<label kind="synchronisation" x="-119" y="-93">unlock!</label>
			<nail x="-85" y="-76"/>
			<nail x="-102" y="-76"/>
		</transition>
	</template>
	<template>
		<name x="5" y="5">Car</name>
		<declaration>// Place local declarations here.
clock t;</declaration>
		<location id="id19" x="-399" y="-152">
			<name x="-535" y="-186">OpenAndUnlocked</name>
		</location>
		<location id="id20" x="-399" y="-59">
			<name x="-510" y="-50">OpenAndLocked</name>
		</location>
		<location id="id21" x="-229" y="-152">
			<name x="-229" y="-186">ClosedAndUnlocked</name>
		</location>
		<location id="id22" x="-229" y="-59">
			<name x="-229" y="-50">ClosedAndLocked</name>
			<label kind="invariant" x="-204" y="-34">t &lt;= 20</label>
		</location>
		<location id="id23" x="-110" y="-110">
		</location>
		<location id="id24" x="51" y="-110">
